# Image tag baked into release packages; override when pulling from a registry.
KRONKEEPER_IMAGE=kronkeeper:latest

# Host port mapped to the API (container always listens on 2401).
API_PORT=2401

# PostgreSQL (used by the postgres service and DATABASE_URL in compose).
POSTGRES_USER=kronkeeper
POSTGRES_PASSWORD=kronkeeper
POSTGRES_DB=kronkeeper

# Worker pool
WORKER_COUNT=10
WORKER_QUEUE_SIZE=1000

# Scheduler
HEAP_LOOKAHEAD_LIMIT=10000
LEASE_DURATION_SECS=30
LEASE_REAPER_INTERVAL_SECS=10

# Retries
MAX_RETRY_BACKOFF_SECS=3600

# Webhooks
WEBHOOK_TIMEOUT_SECS=5
WEBHOOK_MAX_RETRIES=3

# Script execution (mounted from ./scripts in this bundle)
SCRIPT_SAFE_DIR=/opt/daemon/scripts

# Logging
RUST_LOG=info
